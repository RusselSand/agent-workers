# One connection per worker. Use separate settings/account directories for multiple workers.
AGENT_PROVIDER=claude

# Credentials directory. Keep it outside your repository.
# Default: ~/.agent-worker/<provider>
# AGENT_HOME=../agent-accounts/claude

# Optional model identifier; otherwise use the adapter default.
# AGENT_MODEL=claude-opus-5

# Claude accepts low, medium, high, xhigh, max. Overrides the account's effort setting.
# Codex passes this through as model_reasoning_effort; its default is medium.
# Empty means use the provider default.
# AGENT_EFFORT=high

# Run folders and logs. Default: <AGENT_HOME>/runs
# AGENT_RUNS=../agent-runs/claude

# Refuse new turns at this percentage of the applicable subscription window.
# Default: 95. An explicitly empty value disables the threshold.
# AGENT_REFUSE_ABOVE=95

# Allow spending provider credits when the subscription window is exhausted.
# Default: 1. Set 0 to stop even when credits remain.
# Accepts 1/true/yes or 0/false/no; other values are rejected.
# AGENT_SPEND_CREDITS=1

# Total turn and CLI inactivity limits, in seconds. Empty disables the limit.
# AGENT_TIMEOUT=3600
# AGENT_IDLE_TIMEOUT=900

# Override a CLI executable that is not on PATH.
# Relative paths resolve from this file's directory.
# AGENT_CLAUDE_BINARY=
# AGENT_CODEX_BINARY=
