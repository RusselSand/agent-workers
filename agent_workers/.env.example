# Одно подключение на воркер. Нужны два воркера — будет два таких файла
# (или два набора переменных, или два контейнера). Реестра профилей нет:
# сменить учётную запись значит назвать другой каталог в AGENT_HOME.

AGENT_PROVIDER=claude

# Каталог учётной записи: в нём лежат токены входа, поэтому вне репозитория.
# По умолчанию ~/.agent-worker/<provider>
# AGENT_HOME=D:/PROJECTS/.agent/claude-рабочий

# Модель. Без неё берётся умолчание адаптера.
# AGENT_MODEL=claude-opus-5

# Куда складывать папки ходов с журналами. По умолчанию <AGENT_HOME>/runs
# AGENT_RUNS=D:/PROJECTS/.agent/claude-рабочий/runs

# Не начинать ход, если окно выбрано на столько процентов. Пусто — не ограничивать.
# AGENT_REFUSE_ABOVE=95

# 0 — останавливаться даже когда у провайдера остались кредиты.
# AGENT_SPEND_CREDITS=1

# Сколько готовых и не забранных результатов терпеть, прежде чем встать.
# AGENT_MAX_PENDING=50
